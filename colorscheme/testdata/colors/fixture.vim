" A tiny colorscheme for vim2godot's tests.
hi clear
set background=dark
let g:colors_name = 'fixture'
hi Normal       guifg=#dddddd guibg=#101010
hi Comment      guifg=#777777
hi String       guifg=#88cc66
hi Function     guifg=#ffbb66
hi Keyword      guifg=#cc6666
hi Statement    guifg=#cc6666
hi Type         guifg=#6699cc
hi CursorLine   guibg=#1c1c1c
hi CursorLineNr guifg=#ff8844
hi Visual       gui=reverse
hi DiagnosticError guifg=#ff3366
